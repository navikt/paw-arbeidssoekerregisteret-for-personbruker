{
    "name": "paw-arbeidssoekerregisteret-for-personbruker",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.28.6",
    "scripts": {
        "biome:migrate": "biome migrate --write",
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome lint ./src",
        "lint:fix": "biome check --fix ./src",
        "format": "biome format --write ./src",
        "test": "pnpm lint && vitest",
        "test:ci": "biome ci ./src && vitest run",
        "test:uu-smoke": "node scripts/uu-smoke.mjs",
        "typecheck": "pnpm tsc",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build -o public/storybook",
        "test-storybook": "vitest --config vitest.storybook.config.mts run --project storybook",
        "refresh": "rm -rf node_modules && rm pnpm-lock.yaml && pnpm i --ignore-scripts",
        "prepare": "husky"
    },
    "dependencies": {
        "@grafana/faro-web-sdk": "2.13.0",
        "@navikt/aksel-icons": "8.20.0",
        "@navikt/arbeidssokerregisteret-utils": "3.0.1",
        "@navikt/ds-css": "8.20.0",
        "@navikt/ds-react": "8.20.0",
        "@navikt/ds-tailwind": "8.20.0",
        "@navikt/nav-dekoratoren-moduler": "4.5.2",
        "@navikt/next-logger": "5.0.1",
        "@navikt/oasis": "4.2.2",
        "@unleash/nextjs": "1.6.7",
        "jose": "6.2.13",
        "next": "16.4.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "swr": "2.5.1",
        "uuid": "14.0.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.3",
        "@storybook/addon-a11y": "10.6.3",
        "@storybook/addon-docs": "10.6.3",
        "@storybook/addon-links": "10.6.3",
        "@storybook/addon-onboarding": "10.6.3",
        "@storybook/addon-vitest": "10.6.3",
        "@storybook/nextjs-vite": "10.6.3",
        "@tailwindcss/postcss": "4.3.3",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/jest": "30.0.0",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "@vitest/browser-playwright": "5.0.5",
        "husky": "9.1.7",
        "jsdom": "30.1.3",
        "knip": "6.44.1",
        "lint-staged": "17.6.0",
        "msw": "3.0.3",
        "msw-storybook-addon": "3.0.3",
        "playwright": "1.64.1",
        "postcss": "8.5.31",
        "storybook": "10.6.3",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "engines": {
        "node": ">=26.13.0"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    },
    "lint-staged": {
        "*.{ts,tsx,json,md,js,jsx}": [
            "biome check --write"
        ]
    }
}
