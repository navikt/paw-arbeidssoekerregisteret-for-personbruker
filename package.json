{
    "name": "paw-arbeidssoekerregisteret-for-personbruker",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.22.0",
    "scripts": {
        "dev": "next dev",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "biome lint .",
        "test": "pnpm lint && vitest",
        "test:ci": "biome ci && vitest run",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build -o public/storybook",
        "test-storybook": "test-storybook",
        "refresh": "rm -rf node_modules && rm pnpm-lock.yaml && pnpm i --ignore-scripts",
        "prepare": "husky"
    },
    "dependencies": {
        "@grafana/faro-web-sdk": "2.9.0",
        "@navikt/aksel-icons": "8.16.1",
        "@navikt/arbeidssokerregisteret-utils": "2.1.0",
        "@navikt/ds-css": "8.16.1",
        "@navikt/ds-react": "8.16.1",
        "@navikt/ds-tailwind": "8.16.1",
        "@navikt/nav-dekoratoren-moduler": "4.3.0",
        "@navikt/next-logger": "5.0.0",
        "@navikt/oasis": "4.1.4",
        "@unleash/nextjs": "1.6.7",
        "jose": "6.2.9",
        "next": "16.3.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "swr": "2.5.1",
        "uuid": "14.0.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.7",
        "@chromatic-com/storybook": "5.3.0",
        "@storybook/addon-a11y": "10.5.8",
        "@storybook/addon-docs": "10.5.8",
        "@storybook/addon-links": "10.5.8",
        "@storybook/addon-onboarding": "10.5.8",
        "@storybook/nextjs": "10.5.8",
        "@storybook/test-runner": "0.24.4",
        "@tailwindcss/postcss": "4.3.3",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@types/jest": "30.0.0",
        "@types/node": "26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.0.5",
        "axe-playwright": "2.2.2",
        "concurrently": "10.0.5",
        "husky": "9.1.7",
        "jsdom": "30.0.1",
        "knip": "6.32.1",
        "lint-staged": "17.3.0",
        "msw": "2.15.0",
        "msw-storybook-addon": "3.0.0",
        "playwright": "1.61.1",
        "postcss": "8.5.25",
        "storybook": "10.5.8",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "vite": "8.2.1",
        "vitest": "4.1.10"
    },
    "engines": {
        "node": ">=24.19.0"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    },
    "lint-staged": {
        "*.{ts,tsx,json,md,js,jsx}": [
            "biome check --write"
        ]
    }
}
